<Window x:Class="LightSync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LightSync"
        Icon="Assets/LightSync.ico"
        Width="920"
        Height="860"
        MinWidth="860"
        MinHeight="740"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
  <Window.Resources>
    <LinearGradientBrush x:Key="WordmarkBrush" StartPoint="0,0.5" EndPoint="1,0.5">
      <GradientStop Color="#F4F7FA" Offset="0" />
      <GradientStop Color="#7DFFC3" Offset="0.48" />
      <GradientStop Color="#4CB8FF" Offset="1" />
    </LinearGradientBrush>
  </Window.Resources>
  <Grid>
    <Ellipse Width="520" Height="220" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-80,-90,0,0" IsHitTestVisible="False">
      <Ellipse.Fill>
        <RadialGradientBrush>
          <GradientStop Color="#3328FF9A" Offset="0" />
          <GradientStop Color="#00070A10" Offset="1" />
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>
    <Grid Margin="32,26,32,24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <DockPanel Grid.Row="0" Margin="0,0,0,22">
        <Border DockPanel.Dock="Right" Background="#121822" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="999" Padding="12,7" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource MutedBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
            <TextBlock x:Name="StatusPill" Text="Iniciando" FontSize="12" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal">
          <Image Source="Assets/LightSync.ico" Width="46" Height="46" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="LIGHTSYNC" FontSize="26" FontWeight="Bold" Foreground="{StaticResource WordmarkBrush}" />
            <TextBlock Text="Un reloj. Toda la PC." Margin="0,2,0,0" Foreground="{StaticResource MutedBrush}" FontSize="13" />
          </StackPanel>
        </StackPanel>
      </DockPanel>

      <Border Grid.Row="1" Margin="0,0,0,22" CornerRadius="16" BorderBrush="#334055" BorderThickness="1" Padding="3" Background="#0C1018">
        <Border Height="22" CornerRadius="13" ClipToBounds="True">
          <Border x:Name="PreviewBar" CornerRadius="13" />
        </Border>
      </Border>

      <StackPanel Grid.Row="2" Margin="0,0,0,16">
        <TextBlock Text="EFECTO" Style="{StaticResource SectionLabel}" />
        <UniformGrid Columns="3">
          <RadioButton x:Name="SolidCard" GroupName="Effect" Style="{StaticResource EffectCard}" Margin="0,0,8,0" Checked="EffectPicked">
            <StackPanel>
              <TextBlock Text="Ciclo sólido" FontSize="15" FontWeight="SemiBold" />
              <TextBlock Text="Todo cambia de color junto." Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="RainbowCard" GroupName="Effect" Style="{StaticResource EffectCard}" Margin="4,0" Checked="EffectPicked">
            <StackPanel>
              <TextBlock Text="Arcoíris" FontSize="15" FontWeight="SemiBold" />
              <TextBlock Text="La onda recorre las tiras." Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="StaticCard" GroupName="Effect" Style="{StaticResource EffectCard}" Margin="8,0,0,0" Checked="EffectPicked">
            <StackPanel>
              <TextBlock Text="Color fijo" FontSize="15" FontWeight="SemiBold" />
              <TextBlock Text="Un color, el que elijas." Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </RadioButton>
        </UniformGrid>
        <StackPanel x:Name="ColorPanel" Margin="0,14,0,0" Visibility="Collapsed">
          <TextBlock Text="ESPECTRO" Style="{StaticResource SectionLabel}" />
          <Border CornerRadius="14" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="3" Background="#0C1018">
            <Grid x:Name="SpectrumHost" Height="120" Background="Transparent" ClipToBounds="True" Cursor="Cross"
                  MouseLeftButtonDown="SpectrumDown" MouseMove="SpectrumMove" MouseLeftButtonUp="SpectrumUp">
              <Image x:Name="SpectrumImage" Stretch="Fill" />
              <Ellipse x:Name="SpectrumMarker" Width="16" Height="16" Stroke="White" StrokeThickness="2" Fill="#66000000"
                       HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" />
            </Grid>
          </Border>
        </StackPanel>
      </StackPanel>

      <Border Grid.Row="3" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="16" Padding="16,14" Margin="0,0,0,16">
        <DockPanel>
          <ToggleButton x:Name="MusicToggle" DockPanel.Dock="Right" Content="Apagada" Style="{StaticResource MusicToggle}" Checked="MusicChanged" Unchecked="MusicChanged" VerticalAlignment="Center" />
          <StackPanel>
            <TextBlock Text="Música" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="En silencio se apaga y la onda se queda quieta. El volumen de Windows también baja el brillo." Margin="0,6,16,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
            <TextBlock x:Name="MusicDeviceText" Margin="0,4,16,0" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
          </StackPanel>
        </DockPanel>
      </Border>

      <UniformGrid Grid.Row="4" Columns="2" Margin="0,0,0,16">
        <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="16" Padding="16,14" Margin="0,0,8,0">
          <StackPanel>
            <DockPanel Margin="0,0,0,8">
              <TextBlock x:Name="SpeedText" DockPanel.Dock="Right" Text="8 s" Foreground="{StaticResource TextBrush}" />
              <TextBlock Text="VELOCIDAD" Style="{StaticResource SectionLabel}" Margin="0" />
            </DockPanel>
            <Slider x:Name="SpeedSlider" Minimum="2" Maximum="16" Value="8" IsDirectionReversed="True" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SpeedChanged" />
            <DockPanel Margin="0,2,0,0">
              <TextBlock Text="Lento" Foreground="{StaticResource MutedBrush}" FontSize="12" />
              <TextBlock Text="Rápido" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Right" />
            </DockPanel>
          </StackPanel>
        </Border>
        <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="16" Padding="16,14" Margin="8,0,0,0">
          <StackPanel>
            <DockPanel Margin="0,0,0,8">
              <TextBlock x:Name="BrightnessText" DockPanel.Dock="Right" Text="100 %" Foreground="{StaticResource TextBrush}" />
              <TextBlock Text="BRILLO" Style="{StaticResource SectionLabel}" Margin="0" />
            </DockPanel>
            <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="100" Value="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="BrightnessChanged" />
            <TextBlock x:Name="BrightnessHint" Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" Text="Con música, manda el volumen de Windows." Visibility="Collapsed" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </UniformGrid>

      <DockPanel Grid.Row="5">
        <TextBlock DockPanel.Dock="Top" Text="DISPOSITIVOS" Style="{StaticResource SectionLabel}" />
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
        <ListBox x:Name="DeviceList">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="14,11" Margin="0,0,0,8">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                  <StackPanel>
                    <TextBlock Text="{Binding Role}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Name}" Margin="0,2,12,0" Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <DockPanel Grid.Row="6" Margin="0,14,0,0">
        <Button x:Name="RetryButton" DockPanel.Dock="Left" Content="Reintentar" Style="{StaticResource QuietButton}" Click="RetryClick" Visibility="Collapsed" />
        <Button x:Name="PauseButton" Content="Pausar" MinWidth="140" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" Click="PauseClick" IsEnabled="False" />
      </DockPanel>
    </Grid>
  </Grid>
</Window>
